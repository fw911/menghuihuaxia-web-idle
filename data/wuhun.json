  "recycle_price": {
    "comment": "武魂回收换点券的折算规则。base 为各星级 1 级未激活基础价，activated_bonus 为已激活额外乘数，level_bonus_per 为每升 1 级额外乘数（作用于 base）。最终价 = round(base[star] * (activated?activated_bonus:1) * (1 + level*level_bonus_per))。索引 0~5 对应星级 0~5。",
    "base": [
      5,
      15,
      40,
      100,
      250,
      600
    ],
    "activated_bonus": 1.5,
    "level_bonus_per": 0.1
  },
  "exp_formula": {
    "comment": "武魂打怪吸经验升级公式：每级所需经验 = ceil(coef_by_star[star] * level^power)（level 为当前等级，升到 level+1 所需）。coef_by_star 按星级 0~5 分档，使各星满级累计经验阶梯递增（0★约 4000 万 → 5★约 9000 万）。武魂佩戴后杀怪吸经验（每只怪给双槽各 50% 角色经验），自动升级、满级停吸，满级后方可进化升星。",
    "power": 2.4,
