  "recycle_price": {
    "comment": "武魂回收换点券的折算规则。base 为各星级 1 级未激活基础价，activated_bonus 为已激活额外乘数，level_bonus_per 为每升 1 级额外乘数（作用于 base）。最终价 = round(base[star] * (activated?activated_bonus:1) * (1 + level*level_bonus_per))。索引 0~5 对应星级 0~5。",
    "base": [
      5,
      15,
      40,
      100,
      250,
      600
    ],
    "activated_bonus": 1.5,
    "level_bonus_per": 0.1
  },
